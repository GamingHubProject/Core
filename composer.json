{
    "name": "gaminghubproject/core",
    "description": "Gaming Hub Core plugin: domain models (Games, Servers, Instances, Providers), capability decisions, and data normalization. Never speaks to connectors directly — that's Panel's job.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.011",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0",
        "illuminate/support": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GamingHub\\Core\\": "src/",
            "GamingHub\\Core\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GamingHub\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GamingHub\\Core\\Providers\\CoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
